{
  "name": "@fey/server",
  "private": true,
  "version": "1.0.0",
  "description": "FEY backend - REST API, realtime (Socket.IO) en SQLite database",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "seed": "tsx src/db/seed.ts",
    "reset": "tsx src/db/seed.ts --reset",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pdfkit": "^0.16.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.13.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
